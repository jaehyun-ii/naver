# H100 compose 시크릿 — 복사해서 deploy/.env 로 채운 뒤 사용(리포 커밋 금지).
# 실행: docker compose --env-file deploy/.env -f deploy/docker-compose.h100.yaml up -d
#
# 강한 랜덤 값 생성 예: openssl rand -hex 24

# 콘솔/게이트웨이 관리자 마스터 키 (기본 placeholder면 prod 기동 거부됨)
LLMOPS_MASTER_KEY=CHANGE_ME_openssl_rand_hex_24

# CORS 허용 오리진(JSON 배열). prod에서 "*" 금지.
LLMOPS_CORS_ORIGINS=["https://console.example.com"]

# Postgres (제어평면 상태 + MLflow 백엔드)
POSTGRES_USER=llmops
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=llmops

# MinIO(S3 호환) 오브젝트 스토리지 루트 크리덴셜
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
