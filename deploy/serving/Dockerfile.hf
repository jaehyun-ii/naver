# GB10(aarch64+Blackwell) 호환 서빙 이미지.
# NGC PyTorch(이미 GB10용 torch 빌드 포함) 위에 transformers/서버 의존성만 얹는다.
FROM nvcr.io/nvidia/pytorch:26.03-py3

# 서버 의존성 (torch는 베이스 이미지 것 사용 — 재설치 금지)
RUN pip install --no-cache-dir \
    "transformers>=4.44" "accelerate>=0.33" "peft>=0.13" \
    "fastapi>=0.110" "uvicorn[standard]>=0.29" \
    "pydantic>=2.6" "pydantic-settings>=2.2" "boto3>=1.34"

WORKDIR /app
COPY llmops_core /app/llmops_core

ENV HF_HOME=/hf
EXPOSE 8000
ENTRYPOINT ["python", "-m", "llmops_core.serving.hf_server"]
